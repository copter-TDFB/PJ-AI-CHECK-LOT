# gcloud-specific ignore (สำหรับ gcloud builds submit / app deploy)
.git/
.gitignore
.dockerignore
.claude/
skills-lock.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Tests / dev
tests/
.pytest_cache/
.mypy_cache/
.coverage

# Local images / training data (414 MB — ห้าม upload)
images/
data collect pj check lot/
preview/

# Training / dev scripts
train_classifier.py
train_detector.py
evaluate.py
sort_images.py
preview_pipeline.py
confusion_matrix_eval.py
requirements-train.txt

# Model weights ที่ไม่ใช้ใน production
ai_check lot v2.pt

# Docs
PLAN.md
AGENTS.md
FLOW_PROCESS_PRESENTATION.html
*.md
!CLAUDE.md

# IDE
.vscode/
.idea/

# Env / secrets
.env
.env.*
gcp-key.json
service-account*.json
credentials*.json
client_secret*.json

# Model rollback snapshots — don't bake ~300MB of backups into the image
models/*.bak-*

# Generated / temp dirs (knowledge graph, review scratch)
graphify-out/
.review-test-temp/
.pytest-runs/
.test-tmp/

# Distributable bundle — embeddable Python + deps + REAL creds; never bake into prod image
dist/

# Runtime/test data (drafts, test models, config overrides) — prod uses config/ + GCS
data/
