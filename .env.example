# Template สำหรับ environment variables
# คัดลอกเป็น .env แล้วเติมค่าจริง (ห้าม commit .env)

# GCS durable store (ADR — 2026-06-22) — when set, models + packaging config
# overlays + config_overrides.json are all read/written from this bucket
# instead of Drive/local. Prod sets this; ว่าง = local dev falls back to
# Drive (vars below) / local models/*.pt / data/config_overrides.json.
GCS_CONFIG_BUCKET=

# Google Drive Model Registry (ใช้เมื่อ GCS_CONFIG_BUCKET ว่าง)
# ตั้งค่าบน Cloud Run — file_id ของ active/manifest.json ใน Drive
DRIVE_MANIFEST_FILE_ID=

# Local cache directory สำหรับ model weights ที่ download มา (default /tmp/models)
MODEL_CACHE_DIR=/tmp/models

# Drive reference dataset paths (relative to My Drive root) — wizard notebook uses these
# Default match the existing training notebooks
REFERENCE_DETECTOR_PATH=data check lot
REFERENCE_CLASSIFIER_PATH=data classify check lot

# Local dev fallback — ใช้เมื่อ DRIVE_MANIFEST_FILE_ID ว่าง
MODEL_CLASSIFIER_PATH=models/classifier.pt
MODEL_DETECTOR_PATH=models/detector.pt

# OCR config
OCR_LANG=th+en

# Google Cloud Vision (local dev only — บน Cloud Run ใช้ service account ของ runtime)
# ชี้ไปที่ไฟล์ service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Logging
LOG_LEVEL=INFO

# Confidence threshold สำหรับเตือนผลที่ไม่มั่นใจ
CONFIDENCE_THRESHOLD=0.7

# Drive reference dataset folders (share both with the SA email as Editor)
DRIVE_DETECTOR_DATASET_FOLDER_ID=
DRIVE_CLASSIFIER_DATASET_FOLDER_ID=

# Runtime tuning overrides (ADR 0004) — file_id ของ config_overrides.json บน Drive
# ใช้เมื่อ GCS_CONFIG_BUCKET ว่างเท่านั้น (สร้างไฟล์เปล่า {} แล้วแชร์ให้ SA เป็น Editor)
# — ว่างทั้งคู่ = local dev ใช้ data/config_overrides.json
DRIVE_CONFIG_OVERRIDES_FILE_ID=

# Drive dataset write — OAuth user credentials (ADR 0006)
# Service accounts have 0 Drive storage quota, so dataset uploads must run as a
# real Workspace user. Generate once: `python scripts/generate_drive_token.py`
# (Internal OAuth client → full drive scope, no Google verification needed).
# When all three are set, DriveClient acts as that user; otherwise it falls
# back to the service account / ADC (read-only paths still work).
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
